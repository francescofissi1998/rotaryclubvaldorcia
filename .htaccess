# ==========================================================
#  Rotary Club Val d'Orcia — header di sicurezza (Apache)
#  Caricare questo file nella root del sito.
#  Su GitHub Pages puro viene ignorato: vedi README.
# ==========================================================

<IfModule mod_headers.c>
  # 1. HSTS — forza HTTPS.
  #    ROLLOUT GRADUALE: partire con la riga max-age=300, verificare che HTTPS
  #    funzioni su TUTTI i sottodomini, poi passare a quella da 31536000.
  #  Header always set Strict-Transport-Security "max-age=300"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"

  # 2. Content Security Policy.
  #    script-src è 'self' puro: nel sito non esiste alcuno <script> inline.
  #    'unsafe-inline' resta solo su style-src per gli attributi style=.
  #    require-trusted-types-for blocca le sink DOM-XSS (il sito non usa innerHTML).
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; media-src 'none'; object-src 'none'; frame-src 'none'; worker-src 'none'; manifest-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; require-trusted-types-for 'script'; upgrade-insecure-requests"

  # 3. Anti clickjacking (ridondante con frame-ancestors, per browser datati)
  Header always set X-Frame-Options "DENY"

  # 4. Niente MIME sniffing
  Header always set X-Content-Type-Options "nosniff"

  # 5. Referrer
  Header always set Referrer-Policy "strict-origin-when-cross-origin"

  # 6. Isolamento dell'origine
  Header always set Cross-Origin-Opener-Policy "same-origin"
  Header always set Cross-Origin-Resource-Policy "same-origin"

  # 7. Permissions-Policy — disattiva tutto ciò che il sito non usa
  Header always set Permissions-Policy "accelerometer=(), autoplay=(), browsing-topics=(), camera=(), display-capture=(), encrypted-media=(), fullscreen=(self), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), midi=(), payment=(), picture-in-picture=(), publickey-credentials-get=(), screen-wake-lock=(), usb=(), xr-spatial-tracking=()"

  Header unset X-Powered-By
</IfModule>

# ---------- HTTPS forzato ----------
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]
</IfModule>

# ---------- Expires / Cache ----------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault                          "access plus 1 month"
  ExpiresByType text/html                 "access plus 0 seconds"
  ExpiresByType text/css                  "access plus 1 year"
  ExpiresByType application/javascript    "access plus 1 year"
  ExpiresByType image/jpeg                "access plus 1 year"
  ExpiresByType image/png                 "access plus 1 year"
  ExpiresByType image/webp                "access plus 1 year"
  ExpiresByType image/svg+xml             "access plus 1 year"
  ExpiresByType image/x-icon              "access plus 1 year"
  ExpiresByType font/woff2                "access plus 1 year"
  ExpiresByType application/xml           "access plus 1 day"
  ExpiresByType application/manifest+json "access plus 1 week"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(css|js|jpg|jpeg|png|webp|avif|svg|woff2|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(html|xml|txt|webmanifest)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>

# ---------- Compressione ----------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/xml image/svg+xml application/manifest+json
</IfModule>
<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/css text/plain text/xml application/javascript application/xml image/svg+xml
</IfModule>

# ---------- Tipi MIME ----------
<IfModule mod_mime.c>
  AddType font/woff2 .woff2
  AddType image/webp .webp
  AddType image/avif .avif
  AddType application/manifest+json .webmanifest
</IfModule>

ErrorDocument 404 /404.html
